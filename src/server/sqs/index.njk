{% extends 'layouts/page.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Explore the AWS queues used by CADS Data Service and CADS Bridge. This view is read-only."
  }) }}

  {% set head = [
    {
      text: "Name",
      classes: "name-column"
    },
    {
      text: "Queue",
      classes: "queue-column"
    },
    {
      text: "DLQ",
      classes: "queue-column"
    },
    {
      html: '<span class="govuk-visually-hidden">Actions</span>',
      classes: "action-column"
    }
  ] %}

  {% for queueService in viewModel.queuesByService %}
    {% if queueService.adminEnabled %}
      {% set rows = [] %}
      {% for queue in queueService.queues %}
        {% set row = [
          { text: queue.name, classes: "app-break-word" },
          { text: queue.queueName, classes: "app-break-word" },
          { text: queue.dlqName, classes: "app-break-word" },
          {
            html: '<a href="/dashboard/monitoring/sqs/' + queueService.slug + '/' + queue.name + '" class="govuk-link">Explore<span class="govuk-visually-hidden"> '
              + (queue.name | escape) + '</span></a>'
          }
        ] %}
        {% set _ = rows.push(row) %}
      {% endfor %}
      {{ govukTable({
          caption: queueService.name,
          captionClasses: "govuk-table__caption--m",
          firstCellIsHeader: true,
          head: head,
          rows: rows,
          attributes: { "data-testid": "queue-table" }
        }) }}
    {% else %}
      <h2 class="govuk-heading-m" data-testid="no-queues-heading">{{queueService.name}}</h2>
      <p class="govuk-body" data-testid="no-queues">Administration API is not available for this service</p>
    {% endif %}
  {% endfor %}

{% endblock %}
